# Chave secreta compartilhada para assinatura/validacao JWT (HS256)
# Troque por um valor forte gerado aleatoriamente em producao
JWT_SECRET=eventhub-dev-secret-alterar-em-producao
JWT_EXPIRES_HOURS=8

# Portas dos servicos
GATEWAY_PORT=5000
IDENTIDADE_PORT=5001
NOTIFICACAO_PORT=5002
ORQUESTRADOR_PORT=5003
EVENTOS_PORT=5004
INSCRICOES_PORT=5005
CERTIFICADOS_PORT=5006

# URLs internas de comunicacao entre servicos
IDENTIDADE_URL=http://127.0.0.1:5001
NOTIFICACAO_URL=http://127.0.0.1:5002
ORQUESTRADOR_URL=http://127.0.0.1:5003
EVENTOS_URL=http://127.0.0.1:5004
INSCRICOES_URL=http://127.0.0.1:5005
CERTIFICADOS_URL=http://127.0.0.1:5006

# Bancos de dados SQLite isolados por servico (Database-per-Service)
IDENTIDADE_DB_PATH=data/identidade.db
NOTIFICACAO_DB_PATH=data/notificacoes.db
EVENTOS_DB_PATH=data/eventos.db
INSCRICOES_DB_PATH=data/inscricoes.db
CERTIFICADOS_DB_PATH=data/certificados.db
